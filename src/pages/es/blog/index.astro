---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../../../i18n';
const t = getTranslation('es');
const posts = (await getCollection('blog')).filter(p => p.data.lang === 'es').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const POSTS_PER_PAGE = 12;
const initialPosts = posts.slice(0, POSTS_PER_PAGE);
const hasMore = posts.length > POSTS_PER_PAGE;
---
<BaseLayout locale="es" title="Blog de Inmobiliaria en Antigua Guatemala | ARD" description="Perspectivas expertas sobre reubicación, inversión y vida en Antigua Guatemala. Consejos inmobiliarios y asesoría para extranjeros." image="/images/blog/ai-generated/antigua-blog-hero.jpg">
  <section class="page-hero">
    <div class="container">
      <div class="section-label">{t.blog.label}</div>
      <h1 class="page-hero__title">{t.blog.title}</h1>
      <p class="page-hero__subtitle">{t.blog.subtitle}</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div class="grid-3" id="blog-grid">
        {initialPosts.map(post => (
          <a href={`/es/blog/${post.id}/`} class="blog-card">
            <div class="blog-card__image"><img src={post.data.image} alt={post.data.alt} loading="lazy" width="400" height="250"></div>
            <div class="blog-card__content">
              <div class="blog-card__tag">{post.data.tag}</div>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__excerpt">{post.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
      {hasMore && (
        <div style="text-align:center;margin-top:48px;">
          <button id="load-more-btn" class="btn btn--dark" style="min-width:200px;">Cargar Más Artículos</button>
          <p id="post-count" style="font-size:13px;color:var(--color-text-muted);margin-top:12px;">Mostrando {POSTS_PER_PAGE} de {posts.length} artículos</p>
        </div>
      )}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="content-section" style="padding-top:0;">
    <div class="container" style="max-width:760px;">
      <h2 style="font-size:28px;font-weight:600;margin-bottom:8px;">Bienes Raíces en Antigua Guatemala: Respuestas Rápidas</h2>
      <p style="color:var(--color-text-muted);margin-bottom:32px;">Las preguntas que más nos hacen expatriados e inversionistas, respondidas directamente.</p>
      <div class="faq-item" style="border-bottom:1px solid #e5e7eb;padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">¿Pueden los extranjeros comprar propiedad en Antigua Guatemala?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">Sí. Los extranjeros pueden comprar y poseer propiedad en Guatemala, incluso en Antigua, con los mismos derechos que los ciudadanos. Comprar a través de una sociedad anónima guatemalteca (S.A.) es la práctica estándar, especialmente para propiedades que generan ingresos o alquileres a corto plazo. Un abogado local gestiona el estudio de títulos, el escrow y el registro.</p>
      </div>
      <div class="faq-item" style="border-bottom:1px solid #e5e7eb;padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">¿Cuánto cuesta vivir en Antigua Guatemala?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">Un expatriado puede vivir cómodamente en Antigua con aproximadamente $1,500 a $2,500 al mes, incluyendo renta, servicios, comida y salud. Una pareja que renta una casa amueblada suele presupuestar entre $2,500 y $4,000 mensuales según la zona y el estilo de la vivienda.</p>
      </div>
      <div class="faq-item" style="border-bottom:1px solid #e5e7eb;padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">¿Es seguro invertir en bienes raíces en Antigua?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">Antigua es uno de los mercados inmobiliarios más seguros y establecidos de Centroamérica. Los valores de las propiedades se han mantenido estables y la fuerte demanda de alquiler por turistas y trabajadores remotos lo convierte en un mercado de ingresos confiable. Siempre verifica el título, trabaja con un abogado autorizado y compra mediante estructuras legales adecuadas.</p>
      </div>
      <div class="faq-item" style="padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">¿Cuál es la mejor zona de Antigua para comprar propiedad?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">El Centro Histórico es ideal para ingresos por alquiler y caminabilidad, mientras que zonas como San Pedro Las Huertas, Jocotenango y Santa Lucía Milpas Altas ofrecen más terreno, privacidad y casas más grandes. La mejor elección depende de si planeas alquilarla, vivir en ella o construir.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "¿Pueden los extranjeros comprar propiedad en Antigua Guatemala?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Los extranjeros pueden comprar y poseer propiedad en Guatemala, incluso en Antigua, con los mismos derechos que los ciudadanos. Comprar a través de una sociedad anónima guatemalteca (S.A.) es la práctica estándar." } },
      { "@type": "Question", "name": "¿Cuánto cuesta vivir en Antigua Guatemala?", "acceptedAnswer": { "@type": "Answer", "text": "Un expatriado puede vivir cómodamente en Antigua con aproximadamente $1,500 a $2,500 al mes, incluyendo renta, servicios, comida y salud. Una pareja suele presupuestar entre $2,500 y $4,000 mensuales." } },
      { "@type": "Question", "name": "¿Es seguro invertir en bienes raíces en Antigua?", "acceptedAnswer": { "@type": "Answer", "text": "Antigua es uno de los mercados inmobiliarios más seguros y establecidos de Centroamérica. Los valores se han mantenido estables y la fuerte demanda de alquiler lo convierte en un mercado de ingresos confiable." } },
      { "@type": "Question", "name": "¿Cuál es la mejor zona de Antigua para comprar propiedad?", "acceptedAnswer": { "@type": "Answer", "text": "El Centro Histórico es ideal para ingresos por alquiler y caminabilidad, mientras que zonas como San Pedro Las Huertas, Jocotenango y Santa Lucía Milpas Altas ofrecen más terreno, privacidad y casas más grandes." } }
    ]
  }
</script>

<script define:vars={{ allPosts: posts.map(p => ({ id: p.id, image: p.data.image, alt: p.data.alt, tag: p.data.tag, title: p.data.title, excerpt: p.data.excerpt })), POSTS_PER_PAGE }}>
  let currentPage = 1;
  const btn = document.getElementById('load-more-btn');
  const grid = document.getElementById('blog-grid');
  const countEl = document.getElementById('post-count');
  
  if (btn) {
    btn.addEventListener('click', () => {
      const start = currentPage * POSTS_PER_PAGE;
      const end = start + POSTS_PER_PAGE;
      const nextPosts = allPosts.slice(start, end);
      
      nextPosts.forEach(post => {
        const card = document.createElement('a');
        card.href = `/es/blog/${post.id}/`;
        card.className = 'blog-card';
        card.innerHTML = `
          <div class="blog-card__image"><img src="${post.image}" alt="${post.alt}" loading="lazy" width="400" height="250"></div>
          <div class="blog-card__content">
            <div class="blog-card__tag">${post.tag}</div>
            <h2 class="blog-card__title">${post.title}</h2>
            <p class="blog-card__excerpt">${post.excerpt}</p>
          </div>
        `;
        grid.appendChild(card);
      });
      
      currentPage++;
      const totalShown = Math.min(currentPage * POSTS_PER_PAGE, allPosts.length);
      countEl.textContent = `Mostrando ${totalShown} de ${allPosts.length} artículos`;
      
      if (totalShown >= allPosts.length) {
        btn.style.display = 'none';
        countEl.style.display = 'none';
      }
    });
  }
</script>
