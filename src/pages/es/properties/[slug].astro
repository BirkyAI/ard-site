---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getTranslation } from '../../../i18n';
const t = getTranslation('es');
export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.filter(p => p.data.lang === 'es').map(p => ({ params: { slug: p.id }, props: p }));
}
const property = Astro.props;
const { Content } = await render(property);
const p = property.data;
const isRental = p.type === 'rental';
const displayPrice = p.priceLabel || (isRental ? `$${p.price.toLocaleString()}/mes` : `$${p.price.toLocaleString()}`);
const metaDescription = `${p.title} en ${p.location}, Antigua Guatemala. ${p.beds ? p.beds + ' hab., ' : ''}${p.baths ? p.baths + ' baños, ' : ''}${p.area && p.area !== 'N/A' ? p.area + '. ' : ''}${displayPrice}.`;
---
<BaseLayout locale="es" title={`${p.title} | Antigua Real Estate Development`} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"RealEstateListing","name":p.title,"description":`${p.title} en ${p.location}, Antigua Guatemala`,"url":Astro.url.href,"image":p.image,"offers":{"@type":"Offer","price":p.price,"priceCurrency":"USD","priceSpecification": isRental ? {"@type":"UnitPriceSpecification","price":p.price,"priceCurrency":"USD","billingDuration":"P1M"} : undefined}})} />
  <section style="padding:48px 0;">
    <div class="container">
      <a href="/es/properties/" style="font-size:14px;color:var(--color-text-muted);font-weight:500;display:inline-flex;align-items:center;gap:4px;margin-bottom:24px;">{t.labels.backToProperties}</a>

      {/* GALLERY GRID */}
      {p.gallery && p.gallery.length > 0 && (
        <div class="property-gallery" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:32px;">
          {p.gallery.map((img, i) => (
            <div class="property-gallery__item" data-index={i} style="border-radius:10px;overflow:hidden;cursor:pointer;aspect-ratio:4/3;" onclick="openLightbox(this.dataset.index)">
              <img src={img} alt={`${p.title} - Foto ${i + 1}`} style="width:100%;height:100%;object-fit:cover;transition:transform 0.3s;" loading="lazy" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
            </div>
          ))}
        </div>
      )}

      <div style="display:grid;grid-template-columns:1fr;gap:32px;">
        <div>
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.5px;color:var(--color-text-muted);margin-bottom:4px;">{p.location}</div>
          <h1 style="font-size:clamp(28px,4vw,40px);font-weight:600;letter-spacing:-0.5px;line-height:1.1;margin-bottom:16px;">{p.title}</h1>
          <div style="font-size:clamp(28px,4vw,36px);font-weight:600;letter-spacing:-0.5px;margin-bottom:24px;">{displayPrice}</div>
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:32px;font-size:14px;color:var(--color-text-secondary);">
            {p.beds && <span style="padding:8px 16px;background:var(--color-surface);border-radius:8px;border:1px solid var(--color-border);">{p.beds} {t.labels.bedrooms}</span>}
            {p.baths && <span style="padding:8px 16px;background:var(--color-surface);border-radius:8px;border:1px solid var(--color-border);">{p.baths} {t.labels.bathrooms}</span>}
            {p.area && p.area !== 'N/A' && <span style="padding:8px 16px;background:var(--color-surface);border-radius:8px;border:1px solid var(--color-border);">{p.area}</span>}
            <span style={`padding:8px 16px;background:var(--color-surface);border-radius:8px;border:1px solid var(--color-border);${isRental ? 'color:#16a34a;font-weight:600;' : ''}`}>{p.status}</span>
          </div>
          <a href="/es/contact/" class="btn btn--dark" style="margin-bottom:48px;">{isRental ? t.labels.scheduleViewing : t.labels.inquireAboutProperty}</a>
          <div class="prose"><Content /></div>
        </div>
      </div>
    </div>
  </section>

  {/* LIGHTBOX OVERLAY */}
  <div id="lightbox" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.92);backdrop-filter:blur(8px);align-items:center;justify-content:center;cursor:pointer;" onclick="closeLightbox(event)">
    <button style="position:absolute;top:20px;right:28px;background:none;border:none;color:white;font-size:36px;cursor:pointer;z-index:10001;line-height:1;" onclick="closeLightbox(event)">&times;</button>
    <button style="position:absolute;left:20px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.15);border:none;color:white;font-size:28px;cursor:pointer;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:10001;" onclick="event.stopPropagation();navigateLightbox(-1)">‹</button>
    <img id="lightbox-img" src="" alt="" style="max-width:90vw;max-height:90vh;object-fit:contain;border-radius:8px;box-shadow:0 8px 40px rgba(0,0,0,0.5);" onclick="event.stopPropagation()">
    <button style="position:absolute;right:20px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.15);border:none;color:white;font-size:28px;cursor:pointer;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:10001;" onclick="event.stopPropagation();navigateLightbox(1)">›</button>
    <div id="lightbox-counter" style="position:absolute;bottom:24px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,0.7);font-size:14px;font-weight:500;"></div>
  </div>

  <script is:inline define:vars={{ gallery: p.gallery || [p.image] }}>
    const images = gallery;
    let currentIndex = 0;

    window.openLightbox = function(index) {
      currentIndex = parseInt(index);
      updateLightbox();
      document.getElementById('lightbox').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function(e) {
      if (e) e.stopPropagation();
      document.getElementById('lightbox').style.display = 'none';
      document.body.style.overflow = '';
    };

    window.navigateLightbox = function(dir) {
      currentIndex = (currentIndex + dir + images.length) % images.length;
      updateLightbox();
    };

    function updateLightbox() {
      document.getElementById('lightbox-img').src = images[currentIndex];
      document.getElementById('lightbox-counter').textContent = (currentIndex + 1) + ' / ' + images.length;
    }

    document.addEventListener('keydown', function(e) {
      if (document.getElementById('lightbox').style.display === 'flex') {
        if (e.key === 'Escape') window.closeLightbox();
        if (e.key === 'ArrowLeft') window.navigateLightbox(-1);
        if (e.key === 'ArrowRight') window.navigateLightbox(1);
      }
    });
  </script>
</BaseLayout>
