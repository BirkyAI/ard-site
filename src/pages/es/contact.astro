---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation } from '../../i18n';
const t = getTranslation('es');
---
<BaseLayout locale="es" title="Contactar a Luna Jerney | Antigua Real Estate Development" description="Ponte en contacto con Luna Jerney para bienes raíces en Antigua Guatemala. Consulta gratis para extranjeros y compradores internacionales." image="/images/luna-jerney.jpg">
  <section class="page-hero">
    <div class="container">
      <div class="section-label">{t.contact.label}</div>
      <h1 class="page-hero__title">{t.contact.title}</h1>
      <p class="page-hero__subtitle">{t.contact.subtitle}</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;max-width:960px;margin:0 auto;" class="contact-grid">
        
        <!-- LEFT: Form -->
        <div style="background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);padding:40px;">
          <h2 style="font-size:20px;font-weight:600;margin-bottom:24px;">Enviar un Mensaje</h2>
          <form id="contact-form-es" style="display:flex;flex-direction:column;gap:20px;">
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Tu Nombre</label>
              <input type="text" id="form-name" required style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;" placeholder="Juan Pérez">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Correo Electrónico</label>
              <input type="email" id="form-email" required style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;" placeholder="juan@email.com">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Teléfono (WhatsApp preferido)</label>
              <input type="tel" id="form-phone" style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;" placeholder="+502 5555 1234">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Estoy buscando</label>
              <select id="form-interest" style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;">
                <option value="comprar">Comprar una propiedad</option>
                <option value="alquilar">Alquilar una propiedad</option>
                <option value="invertir">Invertir en bienes raíces</option>
                <option value="mudarme">Mudarme a Antigua</option>
                <option value="ia-web">Servicios de IA / Sitio web</option>
                <option value="no-seguro">No estoy seguro — necesito consejo</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Cuéntame más</label>
              <textarea id="form-message" rows="5" style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;resize:vertical;background:white;" placeholder="¿Qué tipo de propiedad buscas? ¿Requisitos específicos?"></textarea>
            </div>
            <button type="submit" class="btn btn--dark" style="width:100%;justify-content:center;font-size:16px;padding:14px;">
              Enviar Mensaje →
            </button>
          </form>
        </div>

        <!-- RIGHT: Info + Calendly -->
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">💬 WhatsApp</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">{t.contact.whatsappDesc}</p>
            <a href="https://wa.me/50235716181" class="btn btn--dark" style="padding:10px 20px;font-size:14px;">{t.contact.whatsappBtn}</a>
          </div>

          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">📧 {t.contact.emailTitle}</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">{t.contact.emailDesc}</p>
            <a href="mailto:info@antiguarealestatedevelopment.com" style="font-weight:500;">info@antiguarealestatedevelopment.com</a>
          </div>

          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">📅 Agendar una Consulta</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:16px;">Llamada de 30 min — elige un horario</p>
            <div class="calendly-inline-widget" data-url="https://calendly.com/antiguarealestatedevelopment-info/30min" style="min-width:100%;height:400px;border-radius:12px;overflow:hidden;"></div>
          </div>

          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">📸 Instagram</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">{t.contact.instagramDesc}</p>
            <a href="https://www.instagram.com/antiguarealestatedevelopment/" target="_blank" rel="noopener" style="font-weight:500;">@antiguarealestatedevelopment</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('contact-form-es').addEventListener('submit', function(e) {
      e.preventDefault();
      const name = document.getElementById('form-name').value;
      const email = document.getElementById('form-email').value;
      const phone = document.getElementById('form-phone').value;
      const interest = document.getElementById('form-interest').value;
      const message = document.getElementById('form-message').value;
      
      const interestLabels = {
        'comprar': 'Comprar una propiedad',
        'alquilar': 'Alquilar una propiedad',
        'invertir': 'Invertir en bienes raíces',
        'mudarme': 'Mudarme a Antigua',
        'ia-web': 'Servicios de IA / Sitio web',
        'no-seguro': 'No estoy seguro — necesito consejo'
      };
      
      const text = `Hola Luna! Me gustaría contactarte.\n\nNombre: ${name}\nCorreo: ${email}\nTeléfono: ${phone}\nInterés: ${interestLabels[interest] || interest}\n\nMensaje: ${message}`;
      
      window.open(`https://wa.me/50235716181?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>

  <style>
    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
</BaseLayout>