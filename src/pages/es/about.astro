---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation } from '../../i18n';
const t = getTranslation('es');
---
<BaseLayout locale="es" title="Conoce a Luna Jerney | Antigua Real Estate Development" description="Conoce a Luna Jerney, tu agente inmobiliaria extranjera en Antigua Guatemala. Originalmente de los Países Bajos, ayudando a extranjeros desde 2021." image="/images/luna-jerney.jpg">
  <section class="page-hero">
    <div class="container">
      <div class="section-label">{t.about.label}</div>
      <h1 class="page-hero__title">{t.about.title}</h1>
      <p class="page-hero__subtitle">{t.about.subtitle}</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr;gap:48px;align-items:start;max-width:960px;margin:0 auto;">
        <div style="border-radius:24px;overflow:hidden;box-shadow:var(--shadow-lg);max-width:400px;">
          <img src="/images/luna-jerney.jpg" alt="Luna Jerney" style="width:100%;object-fit:cover;">
        </div>
        <div class="prose">
          <h2>{t.about.heading1}</h2>
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
          <h2>{t.about.heading2}</h2>
          <p>{t.about.p3}</p>
          <p>{t.about.p4}</p>
          <h2>{t.about.heading3}</h2>
          <ul>
            <li><strong>English</strong> — {t.about.langEn}</li>
            <li><strong>Español</strong> — {t.about.langEs}</li>
            <li><strong>Nederlands</strong> — {t.about.langNl}</li>
          </ul>
          <h2>{t.about.heading4}</h2>
          <ul>
            {t.about.offerItems.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:64px 0;background:#111;text-align:center;">
    <div class="container" style="max-width:560px;">
      <h2 style="font-size:28px;font-weight:600;color:white;margin-bottom:12px;">¿Listo para Encontrar Tu Hogar?</h2>
      <p style="font-size:16px;color:rgba(255,255,255,0.7);line-height:1.7;margin-bottom:32px;">
        Agenda una consulta gratuita y hablemos de tus metas inmobiliarias en Antigua Guatemala. Sin compromiso.
      </p>
      <a href="/es/contacto/" class="btn btn--primary" style="font-size:16px;padding:14px 32px;">Agendar Consulta Gratis</a>
    </div>
  </section>
</BaseLayout>
