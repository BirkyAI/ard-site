---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Luna Jerney | Antigua Real Estate Development" description="Get in touch with Luna Jerney for real estate in Antigua Guatemala. Free consultation for expats and foreign buyers." image="/images/luna-jerney.jpg">
  <section class="page-hero">
    <div class="container">
      <div class="section-label">Contact</div>
      <h1 class="page-hero__title">Get in Touch</h1>
      <p class="page-hero__subtitle">Book a free consultation and let's discuss your property goals in Antigua Guatemala.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;max-width:960px;margin:0 auto;" class="contact-grid">
        
        <!-- LEFT: Form -->
        <div style="background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);padding:40px;">
          <h2 style="font-size:20px;font-weight:600;margin-bottom:24px;">Send a Message</h2>
          <form id="contact-form" style="display:flex;flex-direction:column;gap:20px;">
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Your Name</label>
              <input type="text" id="form-name" required style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;" placeholder="John Smith">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Email</label>
              <input type="email" id="form-email" required style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;" placeholder="john@email.com">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Phone (WhatsApp preferred)</label>
              <input type="tel" id="form-phone" style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;" placeholder="+1 555 123 4567">
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">I'm looking to</label>
              <select id="form-interest" style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;background:white;">
                <option value="buy">Buy a property</option>
                <option value="rent">Rent a property</option>
                <option value="invest">Invest in real estate</option>
                <option value="relocate">Relocate to Antigua</option>
                <option value="ai-agent">AI Agent / Website services</option>
                <option value="not-sure">Not sure yet — need advice</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-weight:500;margin-bottom:6px;font-size:14px;">Tell me more</label>
              <textarea id="form-message" rows="5" style="width:100%;padding:12px 16px;border:2px solid var(--color-border);border-radius:10px;font-size:15px;resize:vertical;background:white;" placeholder="What kind of property are you looking for? Any specific requirements?"></textarea>
            </div>
            <button type="submit" class="btn btn--dark" style="width:100%;justify-content:center;font-size:16px;padding:14px;">
              Send Message →
            </button>
          </form>
        </div>

        <!-- RIGHT: Info + Calendly -->
        <div style="display:flex;flex-direction:column;gap:24px;">
          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">💬 WhatsApp</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">Fastest way to reach me</p>
            <a href="https://wa.me/50235716181" class="btn btn--dark" style="padding:10px 20px;font-size:14px;">Message on WhatsApp</a>
          </div>

          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">📧 Email</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">For detailed inquiries</p>
            <a href="mailto:info@antiguarealestatedevelopment.com" style="font-weight:500;">info@antiguarealestatedevelopment.com</a>
          </div>

          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">📅 Book a Consultation</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:16px;">Pick a time that works for you</p>
            <div class="calendly-inline-widget" data-url="https://calendly.com/birky-ai-proton/ai-agent-demo-call" style="min-width:100%;height:400px;border-radius:12px;overflow:hidden;"></div>
          </div>

          <div style="padding:24px;background:var(--color-surface);border-radius:16px;border:1px solid var(--color-border);">
            <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">📸 Instagram</h3>
            <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">Follow for new listings</p>
            <a href="https://www.instagram.com/antiguarealestatedevelopment/" target="_blank" rel="noopener" style="font-weight:500;">@antiguarealestatedevelopment</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('contact-form').addEventListener('submit', function(e) {
      e.preventDefault();
      const name = document.getElementById('form-name').value;
      const email = document.getElementById('form-email').value;
      const phone = document.getElementById('form-phone').value;
      const interest = document.getElementById('form-interest').value;
      const message = document.getElementById('form-message').value;
      
      const interestLabels = {
        'buy': 'Buy a property',
        'rent': 'Rent a property',
        'invest': 'Invest in real estate',
        'relocate': 'Relocate to Antigua',
        'ai-agent': 'AI Agent / Website services',
        'not-sure': 'Not sure — need advice'
      };
      
      const text = `Hi Luna! I'd like to get in touch.\n\nName: ${name}\nEmail: ${email}\nPhone: ${phone}\nInterest: ${interestLabels[interest] || interest}\n\nMessage: ${message}`;
      
      window.open(`https://wa.me/50235716181?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>

  <style>
    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
</BaseLayout>