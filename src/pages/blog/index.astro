---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter(p => p.data.lang !== 'es').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const POSTS_PER_PAGE = 12;
const initialPosts = posts.slice(0, POSTS_PER_PAGE);
const hasMore = posts.length > POSTS_PER_PAGE;
---
<BaseLayout title="Antigua Guatemala Real Estate Blog | ARD" description="Expert insights on relocating, investing, and living in Antigua Guatemala. Real estate tips and expat advice." image="/images/blog/ai-generated/antigua-blog-hero.jpg">
  <section class="page-hero">
    <div class="container">
      <div class="section-label">Blog</div>
      <h1 class="page-hero__title">Antigua Guatemala Living & Real Estate</h1>
      <p class="page-hero__subtitle">Expert insights on relocating, investing, and living your best life in Antigua Guatemala.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div class="grid-3" id="blog-grid">
        {initialPosts.map(post => (
          <a href={`/blog/${post.id}/`} class="blog-card">
            <div class="blog-card__image"><img src={post.data.image} alt={post.data.alt} loading="lazy" width="400" height="250"></div>
            <div class="blog-card__content">
              <div class="blog-card__tag">{post.data.tag}</div>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__excerpt">{post.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
      {hasMore && (
        <div style="text-align:center;margin-top:48px;">
          <button id="load-more-btn" class="btn btn--dark" style="min-width:200px;">Load More Posts</button>
          <p id="post-count" style="font-size:13px;color:var(--color-text-muted);margin-top:12px;">Showing {POSTS_PER_PAGE} of {posts.length} posts</p>
        </div>
      )}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="content-section" style="padding-top:0;">
    <div class="container" style="max-width:760px;">
      <h2 style="font-size:28px;font-weight:600;margin-bottom:8px;">Antigua Guatemala Real Estate: Quick Answers</h2>
      <p style="color:var(--color-text-muted);margin-bottom:32px;">The questions expats and investors ask us most, answered directly.</p>
      <div class="faq-item" style="border-bottom:1px solid #e5e7eb;padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">Can foreigners buy property in Antigua Guatemala?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">Yes. Foreigners can buy and own property in Guatemala, including in Antigua, with the same rights as citizens. Buying through a Guatemalan corporation (S.A.) is standard practice, especially for income-producing or short-term rental properties, and gives you liability protection. A local attorney handles the title search, escrow, and registration.</p>
      </div>
      <div class="faq-item" style="border-bottom:1px solid #e5e7eb;padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">How much does it cost to live in Antigua Guatemala?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">A single expat can live comfortably in Antigua on roughly $1,500 to $2,500 per month, covering rent, utilities, food, and healthcare. A couple renting a furnished home typically budgets $2,500 to $4,000 monthly depending on the neighborhood and style of home.</p>
      </div>
      <div class="faq-item" style="border-bottom:1px solid #e5e7eb;padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">Is it safe to invest in Antigua real estate?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">Antigua is one of the safest and most established real estate markets in Central America. Property values have remained stable and strong rental demand from tourists and remote workers makes it a dependable income market. Always verify the title, work with a licensed attorney, and buy through proper legal structures.</p>
      </div>
      <div class="faq-item" style="padding:20px 0;">
        <h3 style="font-size:17px;font-weight:600;margin-bottom:8px;">What is the best area of Antigua to buy property?</h3>
        <p style="color:var(--color-text-secondary);line-height:1.7;">The Historic Center is ideal for rental income and walkability, while neighborhoods like San Pedro Las Huertas, Jocotenango, and Santa Lucía Milpas Altas offer more land, privacy, and larger homes. The best choice depends on whether you plan to rent it out, live in it, or build. We help you compare options against your goals.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Can foreigners buy property in Antigua Guatemala?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Foreigners can buy and own property in Guatemala, including in Antigua, with the same rights as citizens. Buying through a Guatemalan corporation (S.A.) is standard practice, especially for income-producing or short-term rental properties." } },
      { "@type": "Question", "name": "How much does it cost to live in Antigua Guatemala?", "acceptedAnswer": { "@type": "Answer", "text": "A single expat can live comfortably in Antigua on roughly $1,500 to $2,500 per month, covering rent, utilities, food, and healthcare. A couple renting a furnished home typically budgets $2,500 to $4,000 monthly." } },
      { "@type": "Question", "name": "Is it safe to invest in Antigua real estate?", "acceptedAnswer": { "@type": "Answer", "text": "Antigua is one of the safest and most established real estate markets in Central America. Property values have remained stable and strong rental demand makes it a dependable income market. Always verify the title and work with a licensed attorney." } },
      { "@type": "Question", "name": "What is the best area of Antigua to buy property?", "acceptedAnswer": { "@type": "Answer", "text": "The Historic Center is ideal for rental income and walkability, while neighborhoods like San Pedro Las Huertas, Jocotenango, and Santa Lucía Milpas Altas offer more land, privacy, and larger homes." } }
    ]
  }
</script>

<script define:vars={{ allPosts: posts.map(p => ({ id: p.id, image: p.data.image, alt: p.data.alt, tag: p.data.tag, title: p.data.title, excerpt: p.data.excerpt })), POSTS_PER_PAGE }}>
  let currentPage = 1;
  const btn = document.getElementById('load-more-btn');
  const grid = document.getElementById('blog-grid');
  const countEl = document.getElementById('post-count');
  
  if (btn) {
    btn.addEventListener('click', () => {
      const start = currentPage * POSTS_PER_PAGE;
      const end = start + POSTS_PER_PAGE;
      const nextPosts = allPosts.slice(start, end);
      
      nextPosts.forEach(post => {
        const card = document.createElement('a');
        card.href = `/blog/${post.id}/`;
        card.className = 'blog-card';
        card.innerHTML = `
          <div class="blog-card__image"><img src="${post.image}" alt="${post.alt}" loading="lazy" width="400" height="250"></div>
          <div class="blog-card__content">
            <div class="blog-card__tag">${post.tag}</div>
            <h2 class="blog-card__title">${post.title}</h2>
            <p class="blog-card__excerpt">${post.excerpt}</p>
          </div>
        `;
        grid.appendChild(card);
      });
      
      currentPage++;
      const totalShown = Math.min(currentPage * POSTS_PER_PAGE, allPosts.length);
      countEl.textContent = `Showing ${totalShown} of ${allPosts.length} posts`;
      
      if (totalShown >= allPosts.length) {
        btn.style.display = 'none';
        countEl.style.display = 'none';
      }
    });
  }
</script>
