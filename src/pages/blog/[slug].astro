---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(p => p.data.lang !== 'es').map(p => ({ params: { slug: p.id }, props: p }));
}
const post = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<BaseLayout title={`${d.title} | Antigua Real Estate Development`} description={d.excerpt} image={d.image}>
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Article","headline":d.title,"description":d.excerpt,"image":d.image,"datePublished":d.date.toISOString(),"author":{"@type":"Person","name":"Luna Jerney"},"publisher":{"@type":"Organization","name":"Antigua Real Estate Development"}})} />
  <section style="padding:48px 0;">
    <div class="container">
      <a href="/blog/" style="font-size:14px;color:var(--color-text-muted);font-weight:500;display:inline-flex;align-items:center;gap:4px;margin-bottom:24px;">← Back to Blog</a>
      <div style="max-width:720px;margin:0 auto;">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.5px;color:var(--color-text-muted);margin-bottom:8px;">{d.tag}</div>
        <h1 style="font-size:clamp(28px,4vw,40px);font-weight:600;letter-spacing:-0.5px;line-height:1.1;margin-bottom:16px;">{d.title}</h1>
        <div style="font-size:14px;color:var(--color-text-muted);margin-bottom:32px;">{d.date.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})}</div>
        <div style="border-radius:16px;overflow:hidden;margin-bottom:48px;">
          <img src={d.image} alt={d.alt} style="width:100%;aspect-ratio:16/10;object-fit:cover;">
        </div>
        <div class="prose"><Content /></div>

        <!-- CTA -->
        <div style="margin-top:64px;padding:48px;background:#111;border-radius:16px;text-align:center;color:white;">
          <h2 style="font-size:24px;font-weight:600;margin-bottom:12px;">Interested in Antigua Real Estate?</h2>
          <p style="font-size:15px;opacity:0.8;line-height:1.7;margin-bottom:24px;max-width:450px;margin-left:auto;margin-right:auto;">
            Whether you're looking to buy, rent, or invest — I can help. Free consultation, no pressure.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;">
            <a href="/contact/" class="btn btn--primary">Book Free Consultation</a>
            <a href="/properties/" class="btn btn--outline" style="border-color:rgba(255,255,255,0.4);color:white;">Browse Properties</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>