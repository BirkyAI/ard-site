---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Expat Relocation Checklist — Download | Antigua Real Estate Development" description="Your complete relocation checklist for moving to Antigua Guatemala. Download and print." image="/images/header-pool-villa.jpg">
  <section style="padding:32px 0;background:linear-gradient(135deg,#065f46,#059669);color:white;text-align:center;">
    <div class="container">
      <div style="font-size:2.5rem;margin-bottom:12px;">✅</div>
      <h1 style="font-size:28px;font-weight:600;margin-bottom:8px;">Your Checklist Is Ready!</h1>
      <p style="font-size:16px;opacity:0.9;">Print this page or save as PDF to start planning your move to Antigua Guatemala.</p>
      <div style="margin-top:20px;">
        <button onclick="window.print()" class="btn btn--dark" style="font-size:14px;padding:10px 24px;">🖨️ Print / Save as PDF</button>
      </div>
    </div>
  </section>

  <section style="padding:48px 0;background:white;">
    <div class="container">
      <div style="max-width:720px;margin:0 auto;font-size:15px;line-height:1.8;color:#334155;" class="checklist-content">
        
        <div style="text-align:center;margin-bottom:48px;padding:32px;border:2px dashed #e2e8f0;border-radius:16px;">
          <p style="font-size:14px;color:#64748b;margin-bottom:8px;">Antigua Real Estate Development · Relocation Guide</p>
          <h2 style="font-size:26px;font-weight:700;margin-bottom:4px;color:#0f172a;">The Complete Expat Relocation Checklist</h2>
          <p style="color:#64748b;">Your step-by-step guide to moving to Antigua Guatemala</p>
          <div style="margin-top:16px;font-size:13px;color:#94a3b8;">Prepared by Luna Jerney · antigua real estate development</div>
        </div>

        <!-- Section 1 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">1</span> Visa & Residency Planning</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Check your passport validity — need 6+ months remaining</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Research visa options: tourist (90 days), temporary residency, permanent residency</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Tourist visa: citizens of US, Canada, EU, UK get 90 days on arrival (renewable)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Temporary residency: requires $500+/month income proof OR $50K investment in Guatemala</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Connect with a Guatemalan immigration lawyer for residency applications</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Budget residency costs: ~$500-1,500 in legal fees + government fees</span></label>
          </div>
        </div>

        <!-- Section 2 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">2</span> Banking & Finances</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Open a Guatemalan bank account (Industrial Bank, G&T, Banrural are most popular)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Bring: passport, proof of address from home country, reference letter from your bank</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Set up Wise or Xe for international transfers (much cheaper than traditional wire)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Notify your home bank and credit card companies of your move</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Understand tax obligations: Guatemala taxes resident on Guatemalan-source income only</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Set up a digital nomad-friendly credit card with no foreign transaction fees</span></label>
          </div>
        </div>

        <!-- Section 3 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">3</span> Housing Research</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Research neighborhoods: El Hato (nature), Ciudad Vieja (quiet), Historic Center (vibrant)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Visit Antigua first for 1-2 weeks to explore areas in person</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Rental budget: $400-800/month for colonial home, $800-1,500 for modern villa</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Rental requirements: 1-2 months deposit + first month's rent + Guatemalan ID (or passport)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Consider furnished vs unfurnished (most rentals are unfurnished)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>If buying: connect with a real estate agent early — market moves fast</span></label>
          </div>
        </div>

        <!-- Section 4 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">4</span> Healthcare Setup</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Research private health insurance for expats (Pacificare, Mapfre, Seguros G&T)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Private clinics in Antigua: Centro Médico, Hospital Hilario Galindo (good quality)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Bring a 90-day supply of any prescription medications (some may not be available)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Dental care in Antigua: excellent and 60-80% cheaper than US/Europe</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Emergency evacuation insurance recommended (Air Ambulance to US if needed)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Get a complete checkup + dental before leaving home country</span></label>
          </div>
        </div>

        <!-- Section 5 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">5</span> Education (if moving with family)</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>International schools: Antigua International School, Colegio Maya, CAG</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Tuition: $5,000-12,000/year depending on school and grade</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Apply early — popular schools have waiting lists</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Collect school records and transcripts from current school</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Spanish immersion programs available for children</span></label>
          </div>
        </div>

        <!-- Section 6 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">6</span> Legal & Property (if buying)</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Hire a Guatemalan lawyer for due diligence (property title, liens, encumbrances)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Notary (notario) handles deed drafting and registration — required by law</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Closing costs: 4-7% of purchase price (lawyer, notary, registry, taxes)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Foreigners can buy with full ownership rights — no restrictions</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Property tax (IUSI): 0.2-0.6% of assessed value per year — very low</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Consider title insurance for added protection (US-based providers available)</span></label>
          </div>
        </div>

        <!-- Section 7 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">7</span> Moving & Logistics</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Book shipping for household goods (sea freight: 6-8 weeks, air: faster but expensive)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Importing a car: 30-50% import duty — often better to buy used in Guatemala</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Set up mail forwarding (Earth Class Mail, Traveling Mailbox) for important documents</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Cancel or forward subscriptions, memberships, and utilities</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Arrange temporary housing for your first 2-4 weeks (Airbnb is popular)</span></label>
          </div>
        </div>

        <!-- Section 8 -->
        <div class="checklist-section">
          <h3 style="font-size:20px;font-weight:700;color:#0f172a;margin-bottom:16px;display:flex;align-items:center;gap:10px;"><span style="background:#065f46;color:white;width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;">8</span> Settling In — First Month</h3>
          <div style="padding:20px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;">
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Get a Guatemalan SIM card (Tigo or Claro — prepaid, ~$10/month for data)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Set up WiFi at home (Tigo internet: ~$40/month, installation within a week)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Register with your embassy (US Citizens: STEP program, others: local registration)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Join expat Facebook groups (Expats in Antigua, Antigua Guatemala Community)</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Explore the city: mercado, coffee shops, coworking spaces, gyms</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Learn Spanish basics if you don't already — local schools offer $150-250/week immersion</span></label>
            <label style="display:flex;gap:12px;padding:8px 0;cursor:pointer;"><input type="checkbox" style="margin-top:3px;"> <span>Set up garbage, water, security services for your home</span></label>
          </div>
        </div>

        <!-- Final CTA -->
        <div style="margin-top:48px;padding:40px;background:linear-gradient(135deg,#0f172a,#1e1b4b);border-radius:16px;text-align:center;color:white;">
          <h3 style="font-size:22px;font-weight:600;margin-bottom:8px;">Ready to Make the Move?</h3>
          <p style="font-size:15px;opacity:0.8;line-height:1.7;margin-bottom:24px;max-width:450px;margin-left:auto;margin-right:auto;">
            I can help you find the perfect home and connect you with trusted lawyers, contractors, and services in Antigua.
          </p>
          <a href="/contact/" class="btn btn--primary" style="font-size:16px;padding:14px 32px;">Book Free Consultation →</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media print {
      header, footer, .btn--dark, .checklist-content > div:first-child { display: none; }
      body { background: white; }
      .checklist-content { max-width: 100%; margin: 0; }
      .checklist-section { page-break-inside: avoid; }
      label { break-inside: avoid; }
    }
  </style>
</BaseLayout>