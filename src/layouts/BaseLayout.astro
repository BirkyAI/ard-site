---
import { getTranslation, getLocaleFromUrl, getOppositeLocalePath, type Locale } from '../i18n';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  locale?: Locale;
}
const { title, description, image = '/images/og-default.jpg', canonical, locale: localeProp } = Astro.props;
const locale: Locale = localeProp || getLocaleFromUrl(Astro.url);
const t = getTranslation(locale);
const canonicalURL = canonical || Astro.url.href;
const siteBase = 'https://antiguarealestatedevelopment.com';
const currentPath = Astro.url.pathname;
const breadcrumbItems = (() => {
  const parts = currentPath.replace(/^\/(es\/)?/, '').replace(/\/$/, '').split('/').filter(Boolean);
  const items = [
    { '@type': 'ListItem', position: 1, name: locale === 'es' ? 'Inicio' : 'Home', item: `${siteBase}/${locale === 'es' ? 'es/' : ''}` },
  ];
  let cumulativePath = locale === 'es' ? '/es/' : '/';
  parts.forEach((part, i) => {
    cumulativePath += `${part}/`;
    const name = part.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
    items.push({ '@type': 'ListItem', position: i + 2, name, item: `${siteBase}${cumulativePath}` });
  });
  return items;
})();
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
});
const switchPath = getOppositeLocalePath(Astro.url);
const switchLabel = locale === 'en' ? 'ES' : 'EN';
const whatsappMsg = encodeURIComponent(t.whatsappMessage);
const imageSrc = image.startsWith('http') ? image : `https://antiguarealestatedevelopment.com${image}`;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:site_name" content="Antigua Real Estate Development">
  <meta property="og:image" content={imageSrc}>
  <meta property="og:locale" content={locale === 'es' ? 'es_GT' : 'en_US'}>
  {locale === 'en' && <meta property="og:locale:alternate" content="es_GT" />}
  {locale === 'es' && <meta property="og:locale:alternate" content="en_US" />}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageSrc}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/global.css">
  <link rel="alternate" hreflang="en" href={`https://antiguarealestatedevelopment.com${locale === 'es' ? switchPath : Astro.url.pathname}`} />
  <link rel="alternate" hreflang="es" href={`https://antiguarealestatedevelopment.com${locale === 'es' ? Astro.url.pathname : switchPath}`} />
  <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TKJVTP4L6Z"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TKJVTP4L6Z');
  </script>
</head>
<body>
  <header class="header">
    <div class="container header__inner">
      <a href={locale === 'es' ? '/es/' : '/'} class="header__logo">
        <img src="/images/logo.jpg" alt="Antigua Real Estate Development" class="header__logo-img" width="42" height="42">
        <div class="header__logo-text">Antigua Real Estate<span class="header__logo-sub">Development</span></div>
      </a>
      <nav class="header__nav">
        <a href={locale === 'es' ? '/es/properties/' : '/properties/'}>{t.nav.properties}</a>
        <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.nav.services}</a>
        <a href="/neighborhoods/">{t.nav.neighborhoods}</a>
        <a href={locale === 'es' ? '/es/blog/' : '/blog/'}>{t.nav.blog}</a>
        <a href={locale === 'es' ? '/es/about/' : '/about/'}>{t.nav.about}</a>
        <a href={locale === 'es' ? '/es/contact/' : '/contact/'}>{t.nav.contact}</a>
      </nav>
      <div class="header__actions">
        <a href={switchPath} class="header__lang-btn" aria-label={locale === 'en' ? 'Switch to Spanish' : 'Cambiar a Inglés'}>{switchLabel}</a>
        <a href={locale === 'es' ? '/es/contact/' : '/contact/'} class="header__cta">{t.headerCta}</a>
      </div>
      <button class="header__menu-btn" onclick="document.querySelector('.mobile-menu').classList.toggle('active')" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
  <div class="mobile-menu">
    <a href={locale === 'es' ? '/es/properties/' : '/properties/'}>{t.nav.properties}</a>
    <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.nav.services}</a>
    <a href="/neighborhoods/">{t.nav.neighborhoods}</a>
    <a href={locale === 'es' ? '/es/blog/' : '/blog/'}>{t.nav.blog}</a>
    <a href={locale === 'es' ? '/es/about/' : '/about/'}>{t.nav.about}</a>
    <a href={locale === 'es' ? '/es/contact/' : '/contact/'}>{t.nav.contact}</a>
    <a href={switchPath} class="mobile-lang-btn">{locale === 'en' ? '🇪🇸 Español' : '🇺🇸 English'}</a>
  </div>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div>
          <div class="footer__brand-name">Antigua Real Estate <span>Development</span></div>
          <p class="footer__brand-text">{t.footer.brandText}</p>
          <div class="footer__social">
            <a href="https://www.instagram.com/realtor.antigua.guatemala/" aria-label="Realtor Antigua Guatemala on Instagram" target="_blank" rel="noopener" class="social-icon social-icon--ig">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href="https://www.facebook.com/AntiguaRealEstateDevelopment" aria-label="Facebook" target="_blank" rel="noopener" class="social-icon social-icon--fb">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@realtor_antigua_gt" aria-label="TikTok" target="_blank" rel="noopener" class="social-icon social-icon--tt">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
          </div>
        </div>
        <div>
          <div class="footer__heading">{t.footer.quickLinks}</div>
          <div class="footer__links">
            <a href={locale === 'es' ? '/es/properties/' : '/properties/'}>{t.nav.properties}</a>
            <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.nav.services}</a>
            <a href={locale === 'es' ? '/es/about/' : '/about/'}>{t.footer.aboutLuna}</a>
            <a href={locale === 'es' ? '/es/blog/' : '/blog/'}>{t.nav.blog}</a>
            <a href={locale === 'es' ? '/es/contact/' : '/contact/'}>{t.nav.contact}</a>
          </div>
        </div>
        <div>
          <div class="footer__heading">{t.footer.services}</div>
          <div class="footer__links">
            <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.footer.propertySearch}</a>
            <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.footer.relocationSupport}</a>
            <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.footer.investmentAdvisory}</a>
            <a href={locale === 'es' ? '/es/services/' : '/services/'}>{t.footer.legalGuidance}</a>
          </div>
        </div>
      </div>
      <div class="footer__bottom">
        <span>{t.footer.copyright}</span>
        <span>{t.footer.location}</span>
      </div>
    </div>
  </footer>

  <a href={`https://wa.me/50235716181?text=${whatsappMsg}`} class="whatsapp-fab" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">WA</a>
  <Analytics />
</body>
</html>
